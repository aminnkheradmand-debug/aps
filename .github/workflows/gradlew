#!/bin/sh
#
# APS V4 Gradle bootstrap — generated by Android Patch Studio (FORGE/1).
# If gradle/wrapper/gradle-wrapper.jar is missing, this script falls back to a
# system Gradle. Run `gradle wrapper` once to materialise the standard wrapper.

APP_BASE_NAME=`basename "$0"`
APP_HOME=`pwd -P`
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD=java
fi

if [ ! -f "$CLASSPATH" ]; then
    echo "[aps] gradle-wrapper.jar not found — using system Gradle." >&2
    echo "[aps] Tip: run `gradle wrapper` once to generate the standard wrapper." >&2
    exec gradle "$@"
fi

exec "$JAVACMD" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
