    "pageLoadingBgColor": "#0C1017"
  },
  "permissions": {
    "internet": true,
    "networkState": true,
    "storage": true,
    "media": true,
    "camera": true,
    "location": true,
    "notifications": true,
    "exactAlarms": true,
    "activityRecognition": false,
    "vibration": false,
    "phoneState": true
